# Rust
/target

# Nix
/result
/result-*

# npm distribution build artifacts: platform packages (carry the native binary) and packed tarballs
# are assembled in CI/locally from the Rust build, never committed. The launcher `npm/thepia` is tracked.
/npm/platforms/
/npm/dist/

# Local scratch: plans, design sketches and cross-agent exchanges. Never committed; the durable
# record lives in docs/ (see docs/skills/).
docs/scratch/

# VS Code extension build artifacts (editors/vscode): installed deps, compiled JS, and packed .vsix
# are built from source, never committed. The extension source (src/, package.json) is tracked.
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/*.vsix

# OS / editor
.DS_Store
.idea/
*.swp

.claude/**/*-workspace
